<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">

	<LinearLayout
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="?attr/colorPrimary"
		android:elevation="4dp">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnBack"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:text="←"
			android:textSize="20sp"
			android:textColor="@color/on_primary"
			android:insetTop="0dp"
			android:insetBottom="0dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Settings"
			android:textSize="18sp"
			android:textColor="@color/on_primary"
			android:gravity="center"
			android:layout_marginEnd="40dp" />
	</LinearLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="16dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="General"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingBottom="8dp" />

			<Switch
				android:id="@+id/setShowFps"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Show FPS"
				android:textSize="14sp"
				android:gravity="center_vertical"
				android:showText="false" />

			<Switch
				android:id="@+id/setKeepScreen"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Keep Screen Alive"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<Switch
				android:id="@+id/setHideSysBtn"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Hide System Buttons"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Performance"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingTop="16dp"
				android:paddingBottom="8dp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="FPS Limit"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setFpsLimit"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="60"
					android:textSize="13sp" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Renderer"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setRenderer"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Software"
					android:textSize="13sp" />
			</LinearLayout>

		</LinearLayout>
	</ScrollView>
</LinearLayout>
