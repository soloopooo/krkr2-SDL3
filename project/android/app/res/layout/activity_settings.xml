<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface">

			<LinearLayout
				android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:background="?attr/colorPrimary"
		android:elevation="4dp">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btnBack"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="40dp"
			android:layout_height="40dp"
			app:icon="@drawable/ic_close"
			app:iconSize="20dp"
			app:iconTint="@color/on_primary"
			android:insetTop="0dp"
			android:insetBottom="0dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Settings"
			android:textSize="18sp"
			android:textColor="@color/on_primary"
			android:gravity="center"
			android:layout_marginEnd="40dp" />
	</LinearLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="16dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="General"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingBottom="8dp" />

			<Switch
				android:id="@+id/setShowFps"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Show FPS"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<Switch
				android:id="@+id/setOutputLog"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Output Log"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<Switch
				android:id="@+id/setKeepScreen"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Keep Screen Alive"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<Switch
				android:id="@+id/setHideSysBtn"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Hide System Buttons"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<Switch
				android:id="@+id/setRemLastPath"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Remember Last Path"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Memory Usage"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setMemUsage"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Unlimited"
					android:textSize="13sp" />
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Performance"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingTop="16dp"
				android:paddingBottom="8dp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="FPS Limit"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setFpsLimit"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="60"
					android:textSize="13sp" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Renderer"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setRenderer"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Software"
					android:textSize="13sp" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Draw Threads"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setDrawThreads"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Auto"
					android:textSize="13sp" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Tex Compression"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setTexCompress"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="None"
					android:textSize="13sp" />
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Font"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingTop="16dp"
				android:paddingBottom="8dp" />

			<Switch
				android:id="@+id/setForceDefFont"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Force Default Font"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Default Font"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setDefaultFont"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Auto"
					android:textSize="12sp"
					android:ellipsize="start"
					android:maxLines="1" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Font Scale"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setFontScale"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="100%"
					android:textSize="13sp" />
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Controls"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingTop="16dp"
				android:paddingBottom="8dp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingBottom="8dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="Virtual Cursor Size"
					android:textSize="14sp" />

				<TextView
					android:id="@+id/setCursorVal"
					android:layout_width="36dp"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:textSize="13sp"
					android:textColor="?attr/colorPrimary" />
			</LinearLayout>

			<SeekBar
				android:id="@+id/setCursorScale"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:max="20"
				android:progress="10"
				android:paddingStart="8dp"
				android:paddingEnd="8dp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Debug"
				android:textSize="13sp"
				android:textColor="?attr/colorPrimary"
				android:textStyle="bold"
				android:paddingTop="16dp"
				android:paddingBottom="8dp" />

			<Switch
				android:id="@+id/setDebugLayer"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:text="Enable Debug Layer"
				android:textSize="14sp"
				android:gravity="center_vertical" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="TCP Port"
					android:textSize="14sp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/setDebugPort"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="Disabled"
					android:textSize="13sp" />
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Enable debug layer to use frame stepping, draw-call capture, and texture dumping. Connect PC tool via 'adb forward tcp:PORT tcp:PORT' then run tools/krkr2-debug.py"
				android:textSize="11sp"
				android:textColor="?android:attr/textColorTertiary"
				android:paddingTop="4dp"
				android:paddingBottom="8dp" />

		</LinearLayout>
	</ScrollView>
</LinearLayout>
